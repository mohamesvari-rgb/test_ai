# ---------------------------------------------------------------------------
# Scientific Evaluation Agent — configuration
# Copy to .env (setup.bat does this for you) and fill in what you use.
# Keys put here are picked up automatically; you never have to type them in
# the browser during a demo.
# ---------------------------------------------------------------------------

# Engine selected by default in the web page and the CLI:
#   avalai | deepseek | ollama | custom | anthropic | mock
LLM_PROVIDER=avalai

# --- AvalAI (Iranian gateway, pay in Toman, OpenAI-compatible) -------------
# Sign up: https://chat.avalai.ir/platform/home  (free starter credit)
AVALAI_API_KEY=
AVALAI_MODEL=deepseek-chat
# AVALAI_BASE_URL=https://api.avalai.ir/v1

# --- DeepSeek official API -------------------------------------------------
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Offline: Ollama on this computer --------------------------------------
# Install: https://ollama.com/download/windows   then run install_offline_model.bat
OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window (tokens) requested from the local model.
# OLLAMA_NUM_CTX=24576

# --- Any other OpenAI-compatible endpoint (OpenRouter, LM Studio, vLLM, ...) -
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Anthropic Claude (optional) -------------------------------------------
ANTHROPIC_API_KEY=

# How many answers are evaluated in parallel with online APIs (offline is
# always one at a time).
# LLM_MAX_PARALLEL=4
# Output limit per request for online APIs (includes hidden reasoning tokens).
# LLM_MAX_TOKENS=48000
