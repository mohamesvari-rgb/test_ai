# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Environment / secrets
.env
*.key

# Portable Python downloaded by setup.bat
runtime/

# Generated outputs (workspace = GUI uploads, reports and run history)
output/
reports/
workspace/
